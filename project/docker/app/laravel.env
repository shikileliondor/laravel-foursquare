# .env des conteneurs Docker, monté à la place du .env du projet (lecture seule).
# Valeurs de développement local, aucun secret : APP_KEY vient du .env de la
# machine (voir compose.yaml).
APP_NAME=Laravel
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=foursquare
DB_USERNAME=foursquare
DB_PASSWORD=foursquare

MEDIA_DISK=public
MEDIA_FOLDER=media
PUBLIC_CACHE_STORE=file

SESSION_DRIVER=database
SESSION_LIFETIME=120
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
MAIL_MAILER=log

# Notifications push : déposer le JSON du compte de service Firebase dans
# storage/app/firebase/, puis `docker compose restart queue`.
FCM_CREDENTIALS=storage/app/firebase
